@model StudentManagementSystem.Models.Exam
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

@{
    ViewData["Title"] = "Create Exam";
    var courses = ViewBag.Courses as List<StudentManagementSystem.Models.Course>;
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Create Exam</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- Exam Name -->
        <div class="mb-3">
            <label class="form-label">Exam Name</label>
            <input asp-for="ExamName" class="form-control" />
            <span asp-validation-for="ExamName" class="text-danger"></span>
        </div>

        <!-- Course Dropdown -->
        <div class="mb-3">
            <label class="form-label">Course</label>
            <select asp-for="CourseId" class="form-select">
                <option value="">-- Select Course --</option>
                @foreach (var c in ViewBag.Courses)
                {
                    <option value="@c.CourseId">@c.CourseName</option>
                }
            </select>
            <span asp-validation-for="CourseId" class="text-danger"></span>
        </div>

        <!-- Semester -->
        <div class="mb-3">
            <label class="form-label">Semester</label>
            <input asp-for="Semester" type="number" class="form-control" />
        </div>

        <!-- Exam Date -->
        <div class="mb-3">
            <label class="form-label">Exam Date</label>
            <input asp-for="ExamDate" type="date" class="form-control" />
        </div>

        <!-- Exam Type -->
        <div class="mb-3">
            <label class="form-label">Exam Type</label>
            <select asp-for="ExamType" class="form-select">
                <option value="">-- Select Type --</option>
                <option>Midterm</option>
                <option>Final</option>
                <option>Practical</option>
            </select>
        </div>

        <!-- Duration -->
        <div class="mb-3">
            <label class="form-label">Duration (Minutes)</label>
            <input asp-for="DurationMinutes" type="number" class="form-control" />
        </div>

        <!-- Max Marks -->
        <div class="mb-3">
            <label class="form-label">Max Marks</label>
            <input asp-for="MaxMarks" type="number" class="form-control" />
        </div>

        <!-- Min Marks -->
        <div class="mb-3">
            <label class="form-label">Min Marks</label>
            <input asp-for="MinMarks" type="number" class="form-control" />
        </div>

        <!-- Buttons -->
        <div class="mt-4">
            <button type="submit" class="btn btn-success px-4">
                Save Exam
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
