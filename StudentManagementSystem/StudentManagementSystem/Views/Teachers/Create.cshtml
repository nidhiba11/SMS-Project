@model StudentManagementSystem.Models.Teacher
@{
    ViewData["Title"] = "Add Teacher";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .erp-card {
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        background: #fff;
    }

    .erp-header {
        background: linear-gradient(135deg, #003b3f, #0fa4a9);
        border-radius: 18px 18px 0 0;
        height: 90px;
    }

    .erp-label {
        font-weight: 600;
        color: #003b3f;
        margin-bottom: 6px;
    }

    .erp-input, .erp-select, .erp-textarea {
        border-radius: 12px;
        padding: 12px 14px;
        border: 1px solid #ddd;
    }

    .btn-erp {
        background: linear-gradient(135deg, #003b3f, #0fa4a9);
        border: none;
        color: #fff;
        padding: 10px 28px;
        border-radius: 30px;
        font-weight: 600;
    }
</style>

<div class="container mt-5">
    @if (TempData["msg"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card erp-card border-0">
                <!-- Header -->
                <div class="erp-header d-flex flex-column justify-content-center align-items-center text-white">
                    <i class="bi bi-person-workspace" style="font-size:32px;"></i>
                    <h6 class="mb-0 fw-semibold">Add Teacher</h6>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="erp-label">Select User</label>
                            <select asp-for="UserId" asp-items="ViewBag.Users" class="form-select erp-select">
                                <option value="">-- Select User --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>



                        <!-- Full Name -->
                        <div class="mb-3">
                            <label class="erp-label">Full Name</label>
                            <input asp-for="User.FullName" type="text" class="form-control erp-input" />
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="erp-label">Email</label>
                            <input asp-for="User.Email" type="text" class="form-control erp-input" />
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label class="erp-label">Password</label>
                            <input asp-for="User.Password" type="password" class="form-control erp-input" />
                        </div>

                        <!-- Qualification -->
                        <div class="mb-3">
                            <label class="erp-label">Qualification</label>
                            <input asp-for="Qualification" type="text" class="form-control erp-input" />
                        </div>

                        <!-- Department -->
                        <div class="mb-3">
                            <label class="erp-label">Department</label>
                            <input asp-for="Department" type="text" class="form-control erp-input" />
                        </div>

                        <!-- Experience -->
                        <div class="mb-3">
                            <label class="erp-label">Experience (Years)</label>
                            <input asp-for="Experience" type="number" class="form-control erp-input" />
                        </div>

                        <!-- Bio -->
                        <div class="mb-3">
                            <label class="erp-label">Bio</label>
                            <textarea asp-for="Bio" rows="3" class="form-control erp-textarea"></textarea>
                        </div>

                        <!-- Photo -->
                        <div class="mb-4">
                            <label class="erp-label">Photo</label>
                            <input type="file" name="Photo" class="form-control erp-input" />
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                Back
                            </a>
                            <button type="submit" class="btn btn-erp">
                                <i class="bi bi-save me-1"></i> Save Teacher
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
