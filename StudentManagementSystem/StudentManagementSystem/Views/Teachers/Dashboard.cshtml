@model StudentManagementSystem.Models.ViewModels.TeacherDashboardVM

@{
    ViewData["Title"] = "Teacher Dashboard";
}

<link rel="stylesheet" href="~/css/teacher-dashboard.css" />

<div class="teacher-dashboard">

    <!-- HEADER -->
    <div class="td-header fade-in">
        <h1>Teacher Dashboard</h1>
        <p>Welcome back, <strong>@Model.FullName</strong> 👋</p>
    </div>

    <!-- PROFILE CARD -->
    <div class="td-profile slide-up">
        <img src="@Model.Photo" alt="Teacher Photo" />
        <div class="td-profile-info">
            <h2>@Model.FullName</h2>
            <span>@Model.Qualification</span>
            <p>@Model.Department</p>
            <p><strong>@Model.Experience</strong> Years Experience</p>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="td-stats">

        <div class="td-card zoom-in">
            <i class="bi bi-journal-text"></i>
            <h3>@Model.TotalExams</h3>
            <p>Total Exams</p>
        </div>

        <div class="td-card zoom-in delay-1">
            <i class="bi bi-pencil-square"></i>
            <h3>@Model.ResultsEntered</h3>
            <p>Results Entered</p>
        </div>

        <div class="td-card zoom-in delay-2">
            <i class="bi bi-check-circle"></i>
            <h3>@Model.PublishedExams</h3>
            <p>Published Exams</p>
        </div>

        <div class="td-card zoom-in delay-3">
            <i class="bi bi-people-fill"></i>
            <h3>@Model.StudentsEvaluated</h3>
            <p>Students Evaluated</p>
        </div>

    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
