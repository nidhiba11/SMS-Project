@model StudentManagementSystem.Models.ViewModels.TeacherDashboardVM

@{
    ViewData["Title"] = "Teacher Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher-dashboard.css" asp-append-version="true" />
}

<!-- Dashboard Header -->
<div class="dashboard-header mb-4 d-flex align-items-center gap-4">
    <div class="profile-photo">
        <img src="@(!string.IsNullOrEmpty(Model.Photo) ? Model.Photo : "~/images/default.png")"
             alt="Profile Photo" class="rounded-circle shadow-sm" width="100" height="100" />
    </div>
    <div>
        <h2 class="fw-bold">@Model.FullName</h2>
        <p class="text-muted mb-1">@Model.Department | @Model.Qualification</p>
        <p class="text-muted">Experience: @Model.Experience years</p>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3">
    <!-- Total Exams -->
    <div class="col-md-3 col-sm-6">
        <div class="teacher-card">
            <i class="bi bi-journal-check card-icon"></i>
            <h5>Total Exams</h5>
            <p class="fs-2 fw-bold">@Model.TotalExams</p>
        </div>
    </div>

    <!-- Results Entered -->
    <div class="col-md-3 col-sm-6">
        <div class="teacher-card">
            <i class="bi bi-pencil-square card-icon"></i>
            <h5>Results Entered</h5>
            <p class="fs-2 fw-bold">@Model.ResultsEntered</p>
        </div>
    </div>

    <!-- Published Exams -->
    <div class="col-md-3 col-sm-6">
        <div class="teacher-card">
            <i class="bi bi-upload card-icon"></i>
            <h5>Published Exams</h5>
            <p class="fs-2 fw-bold">@Model.PublishedExams</p>
        </div>
    </div>

    <!-- Students Evaluated -->
    <div class="col-md-3 col-sm-6">
        <div class="teacher-card">
            <i class="bi bi-people card-icon"></i>
            <h5>Students Evaluated</h5>
            <p class="fs-2 fw-bold">@Model.StudentsEvaluated</p>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="mt-4">
    <h4 class="mb-3">Quick Actions</h4>
    <div class="d-flex flex-wrap gap-3">
        <a asp-controller="Exams" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Create Exam
        </a>
        <a asp-controller="Results" asp-action="TeacherIndex" class="btn btn-success">
            <i class="bi bi-file-earmark-text me-1"></i> View Results
        </a>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-info text-white">
            <i class="bi bi-book me-1"></i> View Courses
        </a>
        <a asp-controller="Students" asp-action="Index" class="btn btn-info text-white">
            <i class="bi bi-book me-1"></i> View Students
        </a>
    </div>
</div>
