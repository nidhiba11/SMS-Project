@model StudentManagementSystem.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .erp-card {
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        background: #fff;
    }

    .erp-header {
        background: linear-gradient(135deg, #003b3f, #0fa4a9);
        border-radius: 18px 18px 0 0;
        height: 90px;
    }

    .erp-label {
        font-weight: 600;
        color: #003b3f;
        margin-bottom: 6px;
    }

    .erp-input,
    .erp-textarea {
        border-radius: 12px;
        padding: 12px 14px;
        border: 1px solid #ddd;
    }

        .erp-input:focus,
        .erp-textarea:focus {
            border-color: #0fa4a9;
            box-shadow: 0 0 0 0.2rem rgba(15,164,169,.25);
        }

    .btn-erp {
        background: linear-gradient(135deg, #003b3f, #0fa4a9);
        border: none;
        color: #fff;
        padding: 10px 28px;
        border-radius: 30px;
        font-weight: 600;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">

            <div class="card erp-card border-0">

                <!-- Header -->
                <div class="erp-header d-flex flex-column justify-content-center align-items-center text-white">
                    <i class="bi bi-pencil-square" style="font-size:32px;"></i>
                    <h6 class="mb-0 fw-semibold">Edit Course</h6>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>


                        <!-- Hidden ID -->
                        <input type="hidden" asp-for="CourseId" />

                        <div class="mb-3">
                            <label class="erp-label">
                                <i class="bi bi-journal-text me-1"></i> Course Name
                            </label>
                            <input asp-for="CourseName" class="form-control erp-input" />
                            <span asp-validation-for="CourseName" class="text-danger"></span>
                        </div>

                        <!-- ✅ Description Added -->
                        <div class="mb-3">
                            <label class="erp-label">
                                <i class="bi bi-card-text me-1"></i> Description
                            </label>
                            <textarea asp-for="Description" rows="3"
                                      class="form-control erp-textarea"
                                      placeholder="Course description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="erp-label">
                                    <i class="bi bi-clock me-1"></i> Duration
                                </label>
                                <input asp-for="Duration"
                                       class="form-control erp-input" />
                                <span asp-validation-for="Duration" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="erp-label">
                                    <i class="bi bi-calculator me-1"></i> Total Credits
                                </label>
                                <input asp-for="TotalCredits"
                                       class="form-control erp-input" />
                                <span asp-validation-for="TotalCredits" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="erp-label">
                                <i class="bi bi-building me-1"></i> Department
                            </label>
                            <input asp-for="Department"
                                   class="form-control erp-input" />
                            <span asp-validation-for="Department" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-semibold">
                                Active Course
                            </label>
                        </div>

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                Back
                            </a>
                            <button type="submit" class="btn btn-erp">
                                <i class="bi bi-save me-1"></i> Update Course
                            </button>
                        </div>

                    </form>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
