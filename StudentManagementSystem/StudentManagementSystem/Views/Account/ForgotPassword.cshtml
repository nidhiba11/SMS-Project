@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<link rel="stylesheet" href="~/css/ForgotPassword.css" asp-append-version="true" />

<div class="fp-wrapper">
    <div class="fp-card">

        <div class="fp-header">
            <h2>Forgot Password</h2>
            <p>Enter your registered Gmail to recover your password</p>
        </div>

        <form method="post">
            <div class="fp-input">
                <label>Email Address</label>
                <input type="email"
                       name="email"
                       placeholder="example@gmail.com"
                       required />
            </div>

            <button type="submit" class="fp-btn">
                Recover Password
            </button>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="fp-msg error">@ViewBag.Error</div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="fp-msg success">@ViewBag.Success</div>
        }

        <div class="fp-footer">
            <a asp-action="Login" asp-controller="Account">← Back to Login</a>
        </div>

    </div>
</div>
