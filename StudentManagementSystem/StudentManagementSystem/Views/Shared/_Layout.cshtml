@using Microsoft.AspNetCore.Http
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var role = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Student Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)
</head>

<body>
    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-dark px-4 fixed-top">
        <span class="navbar-brand mb-0 h5">Student Management System</span>
        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">
            Logout
        </a>
    </nav>

    <!-- FLEX WRAPPER: SIDEBAR + MAIN CONTENT -->
    <div class="d-flex-wrapper">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <ul class="nav flex-column nav-pills p-3 gap-1">

                <!-- DASHBOARD -->
                @if (role == "Admin")
                {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Admin" ? "active" : "")"
                           asp-controller="Admin" asp-action="AdminDashboard">
                            Dashboard
                        </a>
                    </li>
                }
                else if (role == "Teacher")
                {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Teachers" && currentAction == "Dashboard" ? "active" : "")"
                           asp-controller="Teachers" asp-action="Dashboard">
                            Dashboard
                        </a>
                    </li>
                }
                else if (role == "Student")
                {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Students" && currentAction == "Dashboard" ? "active" : "")"
                           asp-controller="Students" asp-action="Dashboard">
                            Dashboard
                        </a>
                    </li>
                }

                <!-- STUDENTS (ADMIN + TEACHER ONLY) -->
                @if (role == "Admin" || role == "Teacher")
                {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Students" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Students" asp-action="Index">
                            Students
                        </a>
                    </li>
                }

                <!-- TEACHERS (ADMIN ONLY) -->
                @if (role == "Admin")
                {
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Teachers" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Teachers" asp-action="Details">
                            Teachers
                        </a>
                    </li>
                }

                <!-- COURSES -->
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Courses" ? "active" : "")"
                       asp-controller="Courses" asp-action="Index">
                        Courses
                    </a>
                </li>

                <!-- EXAMS -->
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Exams" ? "active" : "")"
                       asp-controller="Exams" asp-action="Index">
                        Exams
                    </a>
                </li>

                <!-- RESULTS -->
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Results" ? "active" : "")"
                       asp-controller="Results" asp-action="Index">
                        Results
                    </a>
                </li>

            </ul>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
