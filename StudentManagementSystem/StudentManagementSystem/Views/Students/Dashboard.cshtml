@model StudentManagementSystem.Models.ViewModels.StudentDashboardVM
<link rel="stylesheet" href="~/css/student-dashboard.css" />

<div class="student-dashboard">

    <!-- Profile Card -->
    <div class="profile-card">
        <img src="@Model.Photo" alt="Student Photo" />
        <h3>@Model.EnrollmentNo</h3>
        <span class="badge">Semester @Model.Semester</span>
    </div>

    <!-- Info Cards -->
    <div class="info-cards">

        <div class="info-card">
            <p>Age</p>
            <h2>@Model.Age</h2>
        </div>

        <div class="info-card">
            <p>Admission Date</p>
            <h2>@Model.CreatedAt.ToString("dd MMM yyyy")</h2>
        </div>

    </div>

</div>
