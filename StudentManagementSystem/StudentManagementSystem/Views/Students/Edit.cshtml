@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header text-white" style="background-color:#0d6f6a;">
            <h4>Edit Student</h4>
        </div>

        <div class="card-body">

            <!-- TempData Message -->
            @if (TempData["msg"] != null)
            {
                <div class="alert alert-success">
                    @TempData["msg"]
                </div>
            }

            <!-- Validation Summary -->
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            @using (Html.BeginForm("Edit", "Students", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.HiddenFor(m => m.StudentId)

                <div class="mb-3">
                    @Html.LabelFor(m => m.EnrollmentNo)
                    @Html.TextBoxFor(m => m.EnrollmentNo, new { @class = "form-control" })
                    <span asp-validation-for="EnrollmentNo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input class="form-control" value="@Model.User.FullName" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.User.Email" readonly />
                </div>

                <!-- Course Dropdown -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.Course, "Course")
                    @Html.DropDownListFor(
                    m => m.CourseId,
                                new SelectList(ViewBag.Courses, "CourseId", "CourseName", Model.CourseId),
                                "-- Select Course --",
                                new { @class = "form-select" }
                                )
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.DOB)
                @Html.TextBoxFor(m => m.DOB, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                <span asp-validation-for="DOB" class="text-danger"></span>
            </div>

            <!-- Photo -->
            <div class="mb-3">
                <label class="form-label">Photo</label>

                @if (!string.IsNullOrEmpty(Model.Photo))
                    {
                        <div class="mb-2 text-center">
                            <img src="@Url.Content(Model.Photo)" alt="Student Photo"
                                 style="max-width:120px; max-height:120px; border-radius:10px;" />
                        </div>
                    }

                    <input type="file" name="PhotoFile" class="form-control" />
                </div>

                <button type="submit" class="btn text-white" style="background-color:#0d6f6a;">
                    OK
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
